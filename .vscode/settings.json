{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "cSpell.words": [
    "astrosismología",
    "astrosismológico",
    "hidrodinámica",
    "Hidrodinámica"
  ],
  "files.associations": {
    "**/LOGS*/*.data": "csv (whitespace)"
  },
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "latex-workshop.latex.outDir": "./latex-output",
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=%OUTDIR%",
        "--output-directory=%OUTDIR%",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%OUTDIR%/%DOCFILE%"],
      "env": {
        "BIBINPUTS": "%OUTDIR%:"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    },
    {
      "name": "lualatex",
      "tools": ["lualatex"]
    },
    {
      "name": "lualatex ➞ biber ➞ lualatex x2",
      "tools": ["lualatex", "biber", "lualatex", "lualatex"]
    },
    {
      "name": "pdflatex ➞ biber ➞ pdflatex x2",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    },
    {
      "name": "pdflatex ➞ bibtex ➞ pdflatex x2",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "lualatex ➞ biber ➞ lualatex x2"
}
