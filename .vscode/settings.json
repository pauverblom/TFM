{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "cSpell.words": [
    "astrosismolog\u00eda",
    "astrosismol\u00f3gico",
    "hidrodin\u00e1mica",
    "Hidrodin\u00e1mica"
  ],
  "files.associations": {
    "**/LOGS*/*.data": "csv (whitespace)"
  },
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "latex-workshop.latex.outDir": "./latex-output",
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-output-directory=%OUTDIR%",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=%OUTDIR%",
        "--output-directory=%OUTDIR%",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%OUTDIR%/%DOCFILE%"
      ],
      "env": {
        "BIBINPUTS": "%OUTDIR%:"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "lualatex",
      "tools": [
        "lualatex"
      ]
    },
    {
      "name": "lualatex \u279e biber \u279e lualatex x2",
      "tools": [
        "lualatex",
        "biber",
        "lualatex",
        "lualatex"
      ]
    },
    {
      "name": "pdflatex \u279e biber \u279e pdflatex x2",
      "tools": [
        "pdflatex",
        "biber",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "pdflatex \u279e bibtex \u279e pdflatex x2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "lualatex \u279e biber \u279e lualatex x2",
  "latex-workshop.intellisense.citation.backend": "biblatex",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.linting.run": "onType",
  "[latex]": {
    "editor.wordWrap": "on"
  }
}