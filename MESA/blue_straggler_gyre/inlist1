
! inlist_test_rlo

&star_job

   mesa_dir = ''
   show_log_description_at_start = .true.

   pgstar_flag = .true.

/ ! end of star_job namelist


&eos
   ! eos options
   ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
   ! kap options
   ! see kap/defaults/kap.defaults
   use_Type2_opacities = .true.
   Zbase = 0.02

/ ! end of kap namelist


&controls

   extra_terminal_output_file = 'log1' 
   log_directory = 'LOGS1'

   profile_interval = 50
   history_interval = 1
   terminal_interval = 1
   write_header_frequency = 10

/ ! end of controls namelist


&pgstar

   ! Window 1: History Panels (Orbital and Mass Transfer)
   History_Panels1_win_flag = .true.
   History_Panels1_win_width = 6
   History_Panels1_win_aspect_ratio = 1.2
   History_Panels1_title = 'Binary Evolution'
   History_Panels1_num_panels = 3
   History_Panels1_yaxis_name(1) = 'period_days'
   History_Panels1_other_yaxis_name(1) = 'lg_mstar_dot_1' 
   History_Panels1_yaxis_name(2) = 'binary_separation' 
   History_Panels1_other_yaxis_name(2) = 'rl_relative_overflow_1'
   History_Panels1_yaxis_name(3) = 'star_1_mass'
   History_Panels1_other_yaxis_name(3) = 'star_2_mass'

   ! Window 2: HR Diagram
   HR_win_flag = .true.
   HR_win_width = 6
   HR_win_aspect_ratio = 1.0
   HR_title = 'HR Diagram (Donor)'

   ! Window 3: Kippenhahn Diagram
   Kipp_win_flag = .true.
   Kipp_win_width = 8
   Kipp_win_aspect_ratio = 0.6
   Kipp_title = 'Kippenhahn Diagram (Donor)'

/ ! end of pgstar namelist
