
! inlist_test_rlo

&star_job

   mesa_dir = ''
   show_log_description_at_start = .false.

   pgstar_flag = .true.

   create_pre_main_sequence_model = .false.

   ! Write GYRE-compatible pulse data file when the simulation terminates
   save_pulse_data_when_terminate = .true.
   save_pulse_data_filename = 'blue_straggler.GYRE'

/ ! end of star_job namelist


&eos
   ! eos options
   ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
   ! kap options
   ! see kap/defaults/kap.defaults
   use_Type2_opacities = .true.
   Zbase = 0.02

/ ! end of kap namelist


&controls

   extra_terminal_output_file = 'log2' 
   log_directory = 'LOGS2'

   profile_interval = 50
   history_interval = 1
   terminal_interval = 1
   write_header_frequency = 50

   ! solver controls
   ! Removed gold2 tolerances and explicitly loosened the max_residual
   ! to 1d-3 because extreme accretion prevents the 1D solver from 
   ! reaching 1e-4 precision due to numerical noise in the envelope.
   gold_tol_max_residual3 = 1d-3
   varcontrol_target = 5d-4
   retry_limit = 100
   max_number_retries = 100

   ! GYRE output
   pulse_data_format = 'GYRE'
   write_pulse_data_with_profile = .true.

/ ! end of controls namelist


&pgstar

   ! Window 1: HR Diagram (Accretor)
   HR_win_flag = .true.
   HR_win_width = 6
   HR_win_aspect_ratio = 1.0
   HR_title = 'HR Diagram (Accretor)'

   ! Window 2: Kippenhahn Diagram (Accretor)
   Kipp_win_flag = .true.
   Kipp_win_width = 8
   Kipp_win_aspect_ratio = 0.6
   Kipp_title = 'Kippenhahn Diagram (Accretor)'

   ! Window 3: TRho Profile (Internal Structure)
   TRho_Profile_win_flag = .true.
   TRho_Profile_win_width = 6
   TRho_Profile_win_aspect_ratio = 1.0
   TRho_Profile_title = 'TRho Profile (Accretor)'

   ! Window 4: History Panels (Accretor Properties)
   History_Panels1_win_flag = .true.
   History_Panels1_win_width = 6
   History_Panels1_win_aspect_ratio = 1.2
   History_Panels1_title = 'Accretor Evolution'
   History_Panels1_num_panels = 3
   History_Panels1_yaxis_name(1) = 'star_mass'
   History_Panels1_yaxis_name(2) = 'log_L'
   History_Panels1_yaxis_name(3) = 'log_R'
   History_Panels1_other_yaxis_name(:) = ''

/ ! end of pgstar namelist
