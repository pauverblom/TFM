&constants
/

&model
    model_type = 'EVOL'
    ! MESA writes blue_straggler.GYRE at the simulation root when the run terminates.
    file = '../blue_straggler.GYRE'
    file_format = 'MESA'
/

&rot
    ! Empty block indicates zero rotation
/

&mode
    l = 0  ! Radial modes
/

&mode
  l = 1                     ! Dipole modes
/

&mode
  l = 2                     ! Quadrupole modes
/

&osc
    outer_bound = 'VACUUM'
    variables_set = 'JCD'
/

&num
    diff_scheme = 'COLLOC_GL6'
/

&scan
    grid_type = 'LINEAR'
    freq_min = 10
    freq_max = 1500.0
    n_freq = 100
    freq_units = 'UHZ'
/

&grid
/

&ad_output
  summary_file = 'summary.h5'                         ! File name for summary file
  summary_item_list = 'l,n_pg,freq,freq_units,E_norm' ! Fields to appear in summary file
  detail_template = 'detail.l%l.n%n.h5'               ! File name template for detail files
  ! THIS MUST BE ON ONE LINE:
  detail_item_list = 'l,n_pg,omega,x,xi_r,xi_h,c_1,As,V_2,Gamma_1' 
  freq_units = 'CYC_PER_DAY'                          ! Units of frequency-like output fields
/

&nad_output
/
