
! inlist_test_rlo

&star_job

   mesa_dir = ''
   show_log_description_at_start = .true.

   create_pre_main_sequence_model = .false.

/ ! end of star_job namelist


&eos
   ! eos options
   ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
   ! kap options
   ! see kap/defaults/kap.defaults
   use_Type2_opacities = .true.
   Zbase = 0.02

/ ! end of kap namelist


&controls

   extra_terminal_output_file = 'log1' 
   log_directory = 'LOGS1'

   profile_interval = 50
   history_interval = 1
   terminal_interval = 1
   write_header_frequency = 50

   ! solver controls for binary mass transfer
   ! Tighten varcontrol to take careful steps across TAMS, and refine mesh
   ! so structural boundaries don't cause max_residual explosions.
   varcontrol_target = 1d-4
   retry_limit = 100
   max_number_retries = 1000

/ ! end of controls namelist


&pgstar
   read_extra_pgstar_inlist(1) = .true.
   extra_pgstar_inlist_name(1)= 'inlist_pgstar'

/ ! end of pgstar namelist

&colors
/ ! end of colors namelist
