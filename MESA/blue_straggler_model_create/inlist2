
! inlist_test_rlo

&star_job

   mesa_dir = ''
   show_log_description_at_start = .false.

   create_pre_main_sequence_model = .false.

   ! Write GYRE-compatible pulse data file when the simulation terminates
   save_pulse_data_when_terminate = .true.
   save_pulse_data_filename = 'blue_straggler.GYRE'

/ ! end of star_job namelist


&eos
   ! eos options
   ! see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
   ! kap options
   ! see kap/defaults/kap.defaults
   use_Type2_opacities = .true.
   Zbase = 0.02

/ ! end of kap namelist


&controls

   extra_terminal_output_file = 'log2' 
   log_directory = 'LOGS2'

   profile_interval = 50
   history_interval = 1
   terminal_interval = 1
   write_header_frequency = 50

   ! solver controls
   ! Removed gold2 tolerances and explicitly loosened the max_residual
   ! to 1d-3 because extreme accretion prevents the 1D solver from 
   ! reaching 1e-4 precision due to numerical noise in the envelope.
   gold_tol_max_residual3 = 1d-3
   
   ! MLT++ to stabilize superadiabatic radiation-dominated envelope
   okay_to_reduce_gradT_excess = .true.
   
   ! Tighten solver and increase mesh resolution at surface
   mesh_delta_coeff = 0.5
   varcontrol_target = 5d-4
   retry_limit = 100
   max_number_retries = 1000

   ! GYRE output
   pulse_data_format = 'GYRE'
   write_pulse_data_with_profile = .true.

/ ! end of controls namelist



&pgstar
   read_extra_pgstar_inlist(1) = .true.
   extra_pgstar_inlist_name(1)= 'inlist_pgstar'

/ ! end of pgstar namelist

&colors
/ ! end of colors namelist
