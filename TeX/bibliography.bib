@article{Guzik_2021,
  author   = {Guzik, Joyce Ann },
  title    = {Highlights of Discoveries for {$\delta$} Scuti Variable Stars From the Kepler Era},
  journal  = {Frontiers in Astronomy and Space Sciences},
  volume   = {Volume 8 - 2021},
  year     = {2021},
  url      = {https://www.frontiersin.org/journals/astronomy-and-space-sciences/articles/10.3389/fspas.2021.653558},
  doi      = {10.3389/fspas.2021.653558},
  issn     = {2296-987X},
  abstract = {The NASA Kepler mission (2009-2018)  left a legacy of data and discoveries, finding thousands of exoplanets, and also obtaining high-precision long time-series data on hundreds of thousands of stars, including many types of pulsating variables.  Here we highlight a few of the ongoing discoveries from Kepler data for delta Scuti pulsating variables, which are core hydrogen-burning stars of about twice the mass of the Sun.  We discuss many unsolved problems surrounding the properties of the variability in these stars, and the progress enabled by Kepler data in using pulsations to infer their interior structure, a field of research known as asteroseismology.}
}

