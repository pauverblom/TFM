\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Diferencia máxima absoluta en las frecuencias individuales $|\Delta (\nu )|_\mathrm  {max} = |\nu ^{\mathrm  {Ref}}_{n_{pg},l} - \nu ^{\mathrm  {BS}}_{n_{pg},l}|_\mathrm  {max}$ entre la Blue Straggler y la estrella de evolución estándar, para cada par de comparación y modo $l$. La última columna recoge la razón $r = |\Delta (\nu )|_\mathrm  {max}^{l=2}\,/\,|\Delta (\nu )|_\mathrm  {max}^{l=0}$, que cuantifica la mayor sensibilidad diagnóstica de los modos $l=2$ frente a los modos radiales.}}{41}{table.caption.26}\protected@file@percent }
\newlabel{tab:max_diff_indfreq}{{4.2}{41}{Diferencia máxima absoluta en las frecuencias individuales $|\Delta (\nu )|_\mathrm {max} = |\nu ^{\mathrm {Ref}}_{n_{pg},l} - \nu ^{\mathrm {BS}}_{n_{pg},l}|_\mathrm {max}$ entre la Blue Straggler y la estrella de evolución estándar, para cada par de comparación y modo $l$. La última columna recoge la razón $r = |\Delta (\nu )|_\mathrm {max}^{l=2}\,/\,|\Delta (\nu )|_\mathrm {max}^{l=0}$, que cuantifica la mayor sensibilidad diagnóstica de los modos $l=2$ frente a los modos radiales}{table.caption.26}{}}
